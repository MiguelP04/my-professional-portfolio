---
import { Icon } from "astro-icon/components";

const contactLinks = [
  {
    icon: "email",
    label: "Email",
    value: "miguel09112004@gmail.com",
    href: "mailto:miguel09112004@gmail.com",
  },
  {
    icon: "phone",
    label: "Teléfono",
    value: "0412-5804669",
    href: "tel:+584125804669",
  },
  {
    icon: "github",
    label: "GitHub",
    value: "github.com/MiguelP04",
    href: "https://github.com/MiguelP04",
  },
];
---

<section id="contact" class="py-28 px-6 bg-[var(--surface)]/40">
  <div class="max-w-4xl mx-auto text-center">

    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16 justify-center">
      <span class="mono text-[var(--accent)] text-sm tracking-widest">04.</span>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Contacto</h2>
    </div>

    <!-- Lead text -->
    <p class="text-[var(--text-muted)] text-lg leading-relaxed max-w-xl mx-auto mb-12">
      ¿Tienes un proyecto interesante o quieres colaborar?
      Mi bandeja de entrada siempre está abierta.
    </p>

    <!-- Primary CTA -->
    <a
      href="mailto:miguel09112004@gmail.com"
      class="inline-flex items-center gap-3 bg-[var(--accent)] text-[var(--bg)] font-bold px-10 py-4 rounded mono tracking-widest uppercase text-sm hover:shadow-[0_0_32px_#00e5a050] hover:scale-105 transition-all duration-300 mb-16"
    >
      <Icon name="lucide:mail" width="16" height="16" />
      Enviar Email
    </a>

    <!-- Contact links grid -->
    <div class="grid sm:grid-cols-3 gap-4">
      {contactLinks.map((item) => (
        <a
          href={item.href}
          target={item.icon === "github" ? "_blank" : undefined}
          rel={item.icon === "github" ? "noopener noreferrer" : undefined}
          class="group border border-[var(--border)] bg-[var(--surface)] rounded-xl p-5 flex flex-col items-center gap-2 hover:border-[var(--accent)] hover:bg-[var(--accent-dim)] transition-all duration-300"
        >
          <span class="mono text-[var(--accent)] text-xs tracking-widest uppercase mb-1">
            {item.label}
          </span>
          <span class="text-[var(--text-muted)] text-sm group-hover:text-[var(--text)] transition-colors truncate max-w-full">
            {item.value}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

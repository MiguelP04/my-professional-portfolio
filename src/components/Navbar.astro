---
import { Icon } from "astro-icon/components";

const navLinks = [
  { label: "Inicio",      href: "#hero" },
  { label: "Sobre mí",   href: "#about" },
  { label: "Habilidades", href: "#skills" },
  { label: "Proyectos",  href: "#projects" },
  { label: "Contacto",   href: "#contact" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="#hero" class="mono text-[var(--accent)] font-bold text-sm tracking-widest group flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)] inline-block"
        style="animation: pulse-glow 2s infinite;"></span>
      <span>&lt;MDP /&gt;</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link, i) => (
        <li>
          <a
            href={link.href}
            class="mono text-xs text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors duration-200 tracking-wider uppercase"
          >
            <span class="text-[var(--accent)] mr-1">{String(i).padStart(2, '0')}.</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
      aria-label="Toggle menu"
    >
      <Icon name="lucide:menu" width="22" height="22" />
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-[var(--border)] bg-[var(--surface)]/95 backdrop-blur-md"
  >
    <ul class="px-6 py-4 flex flex-col gap-4">
      {navLinks.map((link, i) => (
        <li>
          <a
            href={link.href}
            class="mobile-link mono text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors tracking-wider"
          >
            <span class="text-[var(--accent)] mr-2">{String(i).padStart(2, '0')}.</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const links  = document.querySelectorAll('.mobile-link');

  // Scroll style
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      navbar?.classList.add('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-b', 'border-[var(--border)]');
    } else {
      navbar?.classList.remove('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-b', 'border-[var(--border)]');
    }
  });

  // Mobile toggle
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  links.forEach(link => {
    link.addEventListener('click', () => menu?.classList.add('hidden'));
  });
</script>

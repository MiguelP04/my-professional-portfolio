---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] py-8 px-6">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="mono text-[var(--text-dim)] text-xs tracking-widest">
      &copy; {year} — Miguel David Petit Dávila
    </p>
    <p class="mono text-[var(--text-dim)] text-xs tracking-widest">
      Diseñado &amp; desarrollado con <span class="text-[var(--accent)]">Astro</span> + <span class="text-[var(--accent)]">Tailwind</span>
    </p>
  </div>
</footer>

---
import { Icon } from "astro-icon/components";

const categories = [
  {
    title: "Frontend",
    icon: "lucide:code-2",
    color: "#61dafb",
    skills: ["React.js", "JavaScript ES6+", "HTML5", "CSS3", "Tailwind CSS", "UX/UI Principles"],
  },
  {
    title: "Backend",
    icon: "lucide:server",
    color: "#cc342d",
    skills: ["Node.js", "Express.js", "Ruby on Rails", "FastAPI", "RESTful APIs", "Caché", "Cron Jobs", "Seguridad"],
  },
  {
    title: "Bases de Datos",
    icon: "lucide:database",
    color: "#336791",
    skills: ["PostgreSQL", "MongoDB", "MySQL"],
  },
  {
    title: "IA & Integración",
    icon: "lucide:bot",
    color: "#a855f7",
    skills: ["Integración de IA", "OpenCode", "MCPs"],
  },
  {
    title: "Herramientas",
    icon: "lucide:wrench",
    color: "#f59e0b",
    skills: ["Git", "GitHub", "Postman", "VS Code", "AntiGravity"],
  },
  {
    title: "Habilidades Blandas",
    icon: "lucide:users",
    color: "#00e5a0",
    skills: ["Comunicación Técnica", "Liderazgo Colaborativo", "Pensamiento Analítico", "Adaptabilidad"],
  },
];
---

<section id="skills" class="py-28 px-6 bg-[var(--surface)]/40">
  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16">
      <span class="mono text-[var(--accent)] text-sm tracking-widest">02.</span>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Habilidades</h2>
      <span class="flex-1 h-px bg-[var(--border)] max-w-xs hidden md:block"></span>
    </div>

    <!-- Cards grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map((cat) => (
        <div
          class="group relative border border-[var(--border)] bg-[var(--surface)] rounded-xl p-6 hover:border-[var(--border)] transition-all duration-300 overflow-hidden"
          style={`--cat-color: ${cat.color};`}
        >
          <!-- Hover bg glow -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-xl"
            style={`background: radial-gradient(circle at 0% 0%, ${cat.color}10 0%, transparent 70%);`}
            aria-hidden="true"
          ></div>

          <!-- Card top border accent on hover -->
          <div
            class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            style={`background: linear-gradient(90deg, transparent, ${cat.color}80, transparent);`}
            aria-hidden="true"
          ></div>

          <!-- Icon + Title -->
          <div class="relative flex items-center gap-3 mb-5">
            <Icon name={cat.icon} class="w-6 h-6 shrink-0" style={`color: ${cat.color};`} />
            <h3 class="font-bold text-base tracking-wide text-[var(--text)]">{cat.title}</h3>
          </div>

          <!-- Skill tags -->
          <div class="relative flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span
                class="mono text-[10px] px-2.5 py-1 rounded border tracking-wider transition-all duration-200 group-hover:border-opacity-60"
                style={`
                  color: ${cat.color};
                  border-color: ${cat.color}40;
                  background: ${cat.color}0a;
                `}
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
